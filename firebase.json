{
    "hosting": {
        "public": "client/dist",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "**",
                "run": {
                    "serviceId": "xiv-paint-sim",
                    "region": "northamerica-northeast1"
                }
            }
        ]
    }
}